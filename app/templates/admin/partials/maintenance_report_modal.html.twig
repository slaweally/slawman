<div class="modal fade show" id="maintenanceReportModal" tabindex="-1" style="display:block;" aria-modal="true" role="dialog" aria-labelledby="maintenanceReportModalLabel">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header {{ maintenanceReport.success ? 'bg-success-lt' : 'bg-warning-lt' }}">
                <h5 class="modal-title" id="maintenanceReportModalLabel">
                    <i class="fa-solid {{ maintenanceReport.success ? 'fa-circle-check text-success' : 'fa-triangle-exclamation text-warning' }} me-2"></i>
                    Sistem Bakımı
                </h5>
            </div>
            <div class="modal-body">
                <p class="mb-3">{{ maintenanceReport.message }}</p>

                {% if maintenanceReport.cleared|default([])|length %}
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-2">Temizlenen önbellekler</div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for item in maintenanceReport.cleared %}
                                <span class="badge bg-primary-lt text-primary">{{ item }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if maintenanceReport.details|default([])|length %}
                    <div class="mb-3">
                        <div class="text-muted small text-uppercase fw-semibold mb-2">Kontroller</div>
                        <ul class="list-unstyled mb-0 maintenance-report-list">
                            {% for detail in maintenanceReport.details %}
                                <li><i class="fa-solid fa-check text-success me-2"></i>{{ detail }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if maintenanceReport.warnings|default([])|length %}
                    <div class="alert alert-warning mb-0 py-2">
                        <div class="fw-semibold mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> Uyarılar</div>
                        <ul class="mb-0 ps-3 small">
                            {% for warning in maintenanceReport.warnings %}
                                <li>{{ warning }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
            <div class="modal-footer">
                <a href="{{ app.request.pathInfo }}" class="btn btn-primary">Tamam</a>
            </div>
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>
