{% extends 'admin/layout/base.html.twig' %}
{% block title %}Medya{% endblock %}
{% block page_actions %}
    <span class="text-muted small">Toplam {{ pagination.totalItemCount }} dosya</span>
{% endblock %}
{% block body %}
<form method="post" action="{{ path('admin_media_upload_ajax') }}" enctype="multipart/form-data" class="card mb-3 admin-upload-card" id="upload-form">
    <div class="card-body d-flex flex-wrap align-items-center gap-2 py-3">
        <input type="file" name="file" class="form-control form-control-sm w-auto flex-grow-1" style="max-width:320px">
        <input type="hidden" name="_token" value="{{ csrf_token('media_upload') }}">
        <button type="button" class="btn btn-primary btn-sm" data-media-upload-trigger><i class="bi bi-cloud-upload me-1"></i> Yükle</button>
    </div>
</form>

<div class="admin-media-search">
    <i class="bi bi-search"></i>
    <input type="text" id="media-search-input" placeholder="Dosya adına göre ara..." autocomplete="off">
    <span class="admin-media-search__count" id="media-search-count"></span>
</div>

<div class="media-grid admin-media-grid" id="media-grid">
{% for item in mediaItems %}
    {% set media = item.entity %}
    {% set searchLabel = (media.originalName|default('') ~ ' ' ~ media.alt|default(''))|lower %}
    <a href="{{ path('admin_media_show', {id: media.id}) }}" class="media-grid__item" title="{{ media.originalName }}" data-media-search="{{ searchLabel }}">
        <div class="media-grid__preview">
            {% if media.type.value == 'image' %}
                <img src="{{ item.thumb }}" alt="{{ media.alt|default(media.originalName) }}" loading="lazy">
            {% else %}
                <span class="media-grid__icon">
                    {% if media.type.value == 'document' %}<i class="bi bi-file-earmark-text"></i>
                    {% elseif media.type.value == 'archive' %}<i class="bi bi-file-earmark-zip"></i>
                    {% elseif media.type.value == 'video' %}<i class="bi bi-file-play"></i>
                    {% elseif media.type.value == 'audio' %}<i class="bi bi-file-music"></i>
                    {% else %}<i class="bi bi-file-earmark"></i>
                    {% endif %}
                </span>
            {% endif %}
        </div>
        <span class="media-grid__name">{{ media.originalName|truncate(28) }}</span>
    </a>
{% else %}
    <p class="text-muted">Henüz medya yok.</p>
{% endfor %}
</div>

<script>
(function () {
    const input = document.getElementById('media-search-input');
    const grid = document.getElementById('media-grid');
    const countLabel = document.getElementById('media-search-count');
    if (!input || !grid) return;

    const items = Array.from(grid.querySelectorAll('.media-grid__item'));

    input.addEventListener('input', () => {
        const term = input.value.trim().toLowerCase();
        let visible = 0;

        items.forEach((item) => {
            const haystack = item.dataset.mediaSearch || '';
            const match = term === '' || haystack.includes(term);
            item.classList.toggle('is-hidden', !match);
            if (match) visible++;
        });

        countLabel.textContent = term === '' ? '' : `${visible} / ${items.length} sonuç`;
    });
})();
</script>

{% if pagination.pageCount > 1 %}
<div class="card mt-3">
    <div class="card-footer">{{ knp_pagination_render(pagination, 'admin/partials/pagination.html.twig') }}</div>
</div>
{% endif %}
{% endblock %}
