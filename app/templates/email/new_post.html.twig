{% extends 'email/layout.html.twig' %}

{% block email_body %}
<p style="margin:0 0 8px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:#2D5BE3;">{{ postType }}</p>
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0d1117;">{{ postTitle }}</h1>
{% if postExcerpt %}
<p style="margin:0 0 20px;font-size:15px;color:#57606a;">{{ postExcerpt|nl2br }}</p>
{% endif %}
<table role="presentation" cellpadding="0" cellspacing="0">
    <tr>
        <td style="border-radius:6px;background:#3fb950;">
            <a href="{{ postUrl }}" style="display:inline-block;padding:12px 22px;color:#0d1117;text-decoration:none;font-size:14px;font-weight:600;">Okumaya devam et →</a>
        </td>
    </tr>
</table>
{% endblock %}
