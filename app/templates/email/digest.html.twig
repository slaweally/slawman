{% extends 'email/layout.html.twig' %}

{% block email_body %}
<h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#0d1117;">{{ title }}</h1>
{% if intro %}
<p style="margin:0 0 20px;font-size:15px;color:#57606a;">{{ intro|nl2br }}</p>
{% endif %}
{% if items|length %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #d8dce3;border-radius:6px;overflow:hidden;">
    {% for item in items %}
    <tr>
        <td style="padding:12px 16px;border-bottom:1px solid #eef0f3;font-size:14px;">
            {% if item.url %}
                <a href="{{ item.url }}" style="color:#2D5BE3;text-decoration:none;font-weight:500;">{{ item.title }}</a>
            {% else %}
                <span style="color:#1c2128;">{{ item.title }}</span>
            {% endif %}
        </td>
    </tr>
    {% endfor %}
</table>
{% else %}
<p style="margin:0;font-size:14px;color:#848d97;">Henüz madde eklenmedi.</p>
{% endif %}
{% endblock %}
