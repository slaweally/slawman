{% extends 'email/layout.html.twig' %}

{% block email_body %}
<h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;color:#0d1117;">{{ title }}</h1>
{% if highlight %}
<div style="margin:0 0 20px;padding:14px 16px;background:#fff8e6;border-left:4px solid #f0883e;border-radius:4px;font-size:14px;color:#1c2128;">
    <strong style="display:block;margin-bottom:6px;color:#b45309;">Dikkat</strong>
    {{ highlight|nl2br }}
</div>
{% endif %}
{% if body %}
<div style="margin:0;font-size:15px;color:#1c2128;">{{ body|raw }}</div>
{% endif %}
{% endblock %}
