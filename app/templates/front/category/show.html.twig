{% extends 'front/layout/base.html.twig' %}
{% import 'front/macros/post.html.twig' as ui %}
{% import 'front/macros/layout.html.twig' as layout %}
{% block body %}
{{ layout.archive_header('article', category.name, category.description|default('Bu kategorideki tüm içerikler.')) }}
<div class="feed-list">
{% for post in pagination %}{{ ui.content_card(post) }}
{% else %}<div class="empty-state"><p>Bu kategoride içerik yok.</p></div>{% endfor %}
</div>
{{ knp_pagination_render(pagination) }}
{% endblock %}
