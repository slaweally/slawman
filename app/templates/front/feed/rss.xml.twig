<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
    <title>{{ get_setting('site_title', 'Slaweally') }}</title>
    <link>{{ get_setting('site_url', 'http://localhost:8000') }}</link>
    <description>{{ get_setting('site_description', '') }}</description>
    <language>tr</language>
    {% for post in posts %}
    <item>
        <title>{{ post.title|default(post.content|striptags|truncate(50)) }}</title>
        <link>{{ post_url(post) }}</link>
        <guid>{{ post_url(post) }}</guid>
        <pubDate>{{ post.publishedAt|date('r') }}</pubDate>
        <description><![CDATA[{{ post.excerpt|default(post.content|striptags|truncate(300)) }}]]></description>
    </item>
    {% endfor %}
</channel>
</rss>
