{% extends 'front/layout/base.html.twig' %}
{% import 'front/macros/post.html.twig' as ui %}
{% import 'front/macros/layout.html.twig' as layout %}
{% block body %}
{{ layout.archive_header('software', 'Yazılımlar', 'Geliştirdiğim araçlar, CLI uygulamaları ve dağıtılabilir paketler.') }}
<div class="feed-list feed-list--software">
{% for post in pagination %}{{ ui.software_card(post) }}
{% else %}<div class="empty-state"><p>Henüz yazılım eklenmemiş.</p></div>{% endfor %}
</div>
{{ knp_pagination_render(pagination) }}
{% endblock %}
