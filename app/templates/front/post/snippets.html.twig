{% extends 'front/layout/base.html.twig' %}
{% import 'front/macros/post.html.twig' as ui %}
{% import 'front/macros/layout.html.twig' as layout %}
{% block body %}
{{ layout.archive_header('snippet', 'Snippetler', 'Kod parçacıkları, shell scriptleri ve teknik referanslar.') }}
<div class="card-grid card-grid--snippets">
{% for post in pagination %}{{ ui.snippet_card(post) }}
{% else %}<div class="empty-state card-grid__empty"><p>Henüz snippet eklenmemiş.</p></div>{% endfor %}
</div>
{{ knp_pagination_render(pagination) }}
{% endblock %}
