<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    <url><loc>{{ url('front_home') }}</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
    <url><loc>{{ url('front_blog') }}</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
    <url><loc>{{ url('front_notes') }}</loc><changefreq>daily</changefreq><priority>0.8</priority></url>
    <url><loc>{{ url('front_howto') }}</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
    <url><loc>{{ url('front_troubleshoot') }}</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
    {% for post in posts %}
    <url>
        <loc>{{ post_url(post) }}</loc>
        <lastmod>{{ post.updatedAt|date('Y-m-d') }}</lastmod>
        <changefreq>weekly</changefreq>
        <priority>0.7</priority>
        {% if post.featuredImage %}
        <image:image>
            <image:loc>{{ absolute_url(post.featuredImage) }}</image:loc>
            <image:title>{{ post.title|default('') }}</image:title>
        </image:image>
        {% endif %}
    </url>
    {% endfor %}
    {% for page in pages %}
    <url>
        <loc>{{ page_url(page) }}</loc>
        <lastmod>{{ page.updatedAt|date('Y-m-d') }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
        {% if page.featuredImage %}
        <image:image>
            <image:loc>{{ absolute_url(page.featuredImage) }}</image:loc>
            <image:title>{{ page.title|default('') }}</image:title>
        </image:image>
        {% endif %}
    </url>
    {% endfor %}
    {% for category in categories %}
    <url>
        <loc>{{ category_url(category) }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.5</priority>
    </url>
    {% endfor %}
    {% for tag in tags %}
    <url>
        <loc>{{ tag_url(tag) }}</loc>
        <changefreq>weekly</changefreq>
        <priority>0.4</priority>
    </url>
    {% endfor %}
</urlset>
