{% set metrikaCounterId = get_setting('metrika_counter_id')|default(0)|number_format(0, '', '') %}
<!-- Yandex.Metrika counter -->
<script type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

    ym({{ metrikaCounterId }}, "init", {
        id: {{ metrikaCounterId }},
        clickmap: {{ setting_enabled('metrika_clickmap') ? 'true' : 'false' }},
        trackLinks: {{ setting_enabled('metrika_tracklinks') ? 'true' : 'false' }},
        accurateTrackBounce: {{ setting_enabled('metrika_accurate_track') ? 'true' : 'false' }},
        webvisor: {{ setting_enabled('metrika_webvisor') ? 'true' : 'false' }}
    });
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ metrikaCounterId }}" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
